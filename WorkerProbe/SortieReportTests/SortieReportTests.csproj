<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <ProofHelper Condition="'$(ProofHelper)' == ''">../../../../Temp/UnityPlay/multiplayer/helper/UnityPlay.MultiplayerProof.dll</ProofHelper>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="UnityPlay.MultiplayerProof"><HintPath>$(ProofHelper)</HintPath></Reference>
    <Reference Include="Dungeon.Net"><HintPath>$(ProofManaged)/Dungeon.Net.dll</HintPath></Reference>
    <Reference Include="Unity.Netcode.Runtime"><HintPath>$(ProofManaged)/Unity.Netcode.Runtime.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ProofManaged)/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
