<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule" HintPath="$(UnityManagedPath)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.SharedInternalsModule" HintPath="$(UnityManagedPath)/UnityEngine.SharedInternalsModule.dll"
               Condition="Exists('$(UnityManagedPath)/UnityEngine.SharedInternalsModule.dll')" />
    <Reference Include="UnityEditor.CoreModule" HintPath="$(UnityManagedPath)/UnityEditor.CoreModule.dll" />
  </ItemGroup>
  <Target Name="ValidateUnityManagedPath" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(UnityManagedPath)/UnityEditor.CoreModule.dll')"
           Text="Pass -p:UnityManagedPath=&lt;Editor/Data/Managed/UnityEngine&gt;." />
  </Target>
</Project>
