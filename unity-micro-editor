#!/usr/bin/env bash
set -euo pipefail

tool_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cargo_command="${CARGO:-cargo}"
if ! command -v "$cargo_command" >/dev/null 2>&1; then
  cargo_command="$HOME/.cargo/bin/cargo"
fi
# Build outputs stay in the user cache; cargo's incremental build does the rest.
target_root="${CARGO_TARGET_DIR:-${UNITY_MICRO_EDITOR_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/unity-micro-editor}/target}"

"$cargo_command" build --quiet --locked --release --manifest-path "$tool_root/Cargo.toml" --target-dir "$target_root"
export UNITY_MICRO_EDITOR_ROOT="$tool_root"
exec "$target_root/release/unity-micro-editor" "$@"
