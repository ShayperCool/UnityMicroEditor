<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ManagedProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule"
               Condition="Exists('$(UnityManagedPath)/UnityEngine.SharedInternalsModule.dll')">
      <HintPath>$(UnityManagedPath)/UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateUnityManagedPath" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(UnityManagedPath)/UnityEngine.CoreModule.dll')"
           Text="Pass -p:UnityManagedPath=&lt;directory containing UnityEngine.CoreModule.dll&gt;. Use matching installed Editor or Player managed assemblies." />
  </Target>
</Project>
